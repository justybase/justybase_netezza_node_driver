# Netezza lab / integration test credentials
# Copy to .env (do not commit) or export in your shell.

# Required for integration tests (unless NZ_USE_LAB_DEFAULTS=1)
NZ_DEV_HOST=192.168.0.144
NZ_DEV_PASSWORD=password

# Optional overrides
NZ_DEV_PORT=5480
NZ_DEV_DATABASE=JUST_DATA
NZ_DEV_USER=admin

# Set to 1 to allow hardcoded lab defaults when HOST/PASSWORD are unset
# NZ_USE_LAB_DEFAULTS=1

# Optional: path to a trusted SSL certificate for SSL tests
# NZ_SSL_CERT_PATH=/path/to/server.crt

# Optional: local temp directory for external-table tests / examples
# NZ_LOCAL_TMP_DIR=/tmp/nz
