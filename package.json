{
  "name": "@justybase/netezza-driver",
  "version": "2.4.4",
  "description": "Native TypeScript driver for IBM Netezza / PureData System for Analytics",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/fix-esm-package.js",
    "build:watch": "tsc -p tsconfig.cjs.json --watch",
    "clean": "rimraf dist",
    "docs": "typedoc --entryPoints src/index.ts --out docs-api",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "jest --runInBand --config jest.config.js --testPathPatterns=\\.smoke\\.",
    "test:unit": "jest --runInBand --config jest.config.js --testPathPatterns=\"(\\.unit\\.|TypeConversions|StackOverflowPrevention)\"",
    "test:smoke": "jest --runInBand --config jest.config.js --testPathPatterns=\\.smoke\\.",
    "test:full": "jest --runInBand --config jest.config.js",
    "test:debug": "cross-env DEBUG=nz:* jest --runInBand --config jest.config.js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justybase/justybase_netezza_node_driver.git"
  },
  "bugs": {
    "url": "https://github.com/justybase/justybase_netezza_node_driver/issues"
  },
  "homepage": "https://github.com/justybase/justybase_netezza_node_driver#readme",
  "keywords": [
    "netezza",
    "ibm",
    "database",
    "driver",
    "puredata",
    "nz",
    "typescript",
    "sql",
    "node-netezza",
    "native"
  ],
  "author": "Krzysztof Duśko",
  "license": "Apache-2.0",
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "mitata": "^1.0.34",
    "node-netezza": "^1.3.0",
    "odbc": "^2.5.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
