{
  "name": "@justybase/netezza-driver",
  "version": "1.0.0",
  "description": "Native TypeScript driver for IBM Netezza / PureData System for Analytics",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "jest --runInBand --config jest.config.js --testPathPatterns=\\.smoke\\.",
    "test:smoke": "jest --runInBand --config jest.config.js --testPathPatterns=\\.smoke\\.",
    "test:full": "jest --runInBand --config jest.config.js",
    "test:debug": "set DEBUG=nz:* & jest --runInBand --config jest.config.js",
    "prepublishOnly": "npm run clean && npm run build && npm run test:smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrzysztofDusko/justybase_netezza_node_driver.git"
  },
  "bugs": {
    "url": "https://github.com/KrzysztofDusko/justybase_netezza_node_driver/issues"
  },
  "homepage": "https://github.com/KrzysztofDusko/justybase_netezza_node_driver#readme",
  "keywords": [
    "netezza",
    "ibm",
    "database",
    "driver",
    "puredata",
    "nz",
    "typescript",
    "sql",
    "node-netezza",
    "native"
  ],
  "author": "Krzysztof Duśko",
  "license": "Apache-2.0",
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/debug": "^4.1.12",
    "@types/node": "^25.2.3",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "mitata": "^1.0.34",
    "node-netezza": "^1.3.0",
    "odbc": "^2.4.9",
    "prettier": "^3.0.0",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
