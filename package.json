{
  "name": "@justybase/netezza-driver",
  "version": "2.3.0",
  "description": "Native TypeScript driver for IBM Netezza / PureData System for Analytics",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "jest --runInBand --config jest.config.js --testPathPatterns=\\.smoke\\.",
    "test:smoke": "jest --runInBand --config jest.config.js --testPathPatterns=\\.smoke\\.",
    "test:full": "jest --runInBand --config jest.config.js",
    "test:debug": "cross-env DEBUG=nz:* jest --runInBand --config jest.config.js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrzysztofDusko/justybase_netezza_node_driver.git"
  },
  "bugs": {
    "url": "https://github.com/KrzysztofDusko/justybase_netezza_node_driver/issues"
  },
  "homepage": "https://github.com/KrzysztofDusko/justybase_netezza_node_driver#readme",
  "keywords": [
    "netezza",
    "ibm",
    "database",
    "driver",
    "puredata",
    "nz",
    "typescript",
    "sql",
    "node-netezza",
    "native"
  ],
  "author": "Krzysztof Duśko",
  "license": "Apache-2.0",
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^25.8.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "mitata": "^1.0.34",
    "node-netezza": "^1.3.0",
    "odbc": "^2.5.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
